<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="refresh" content="3;url=https://discord.com/channels/<%= guildId %>">
  <title>Clutch.gg | Verification Success</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    .success-icon {
      font-size: 64px;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <div class="container" style="border-color: var(--success); box-shadow: 0 20px 40px rgba(46, 125, 50, 0.3);">
    <div class="logo-area">
      <h1>FACEITLUTCH</h1>
      <p>Verification Complete</p>
    </div>

    <div class="success-icon">✅</div>

    <h2 style="color: var(--success); font-size: 24px; margin-bottom: 10px;">Account Verified!</h2>
    
    <div style="background: rgba(255,255,255,0.05); border-radius: 8px; padding: 20px; margin: 20px 0; text-align: left;">
      <p style="margin-bottom: 8px;"><strong style="color: var(--gold);">Discord:</strong> <%= user.username %></p>
      <p style="margin-bottom: 8px;"><strong style="color: var(--gold);">Steam ID:</strong> <%= user.steamId64 %></p>
      <p style="margin-bottom: 8px;"><strong style="color: var(--gold);">FACEIT:</strong> <%= user.faceitUsername %></p>
      <p><strong style="color: var(--gold);">Current Level:</strong> Lvl <%= user.faceitLevel %> (<%= user.faceitElo %> ELO)</p>
    </div>

    <p class="step-desc">Your roles and ELO have been updated successfully!</p>
    
    <div class="user-card" style="margin-top: 2rem;">
      <p style="margin-bottom: 1rem; color: #b9bbbe; font-size: 14px;">You will be automatically redirected to the Discord server in 3 seconds...</p>
      <a href="https://discord.com/channels/<%= guildId %>" class="btn btn-discord">Return to Discord Server Now</a>
    </div>
  </div>
</body>
</html>
