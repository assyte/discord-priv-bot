# ─── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Tüm bağımlılıkları kur (devDependencies dahil — TypeScript için gerekli)
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci

# Kaynak kodu ve asset'leri kopyala
COPY src ./src

# TypeScript derle
RUN npx tsc

# ─── Stage 2: Production ──────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

# Sadece production bağımlılıklarını kur ve chromium paketlerini yükle
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Derlenmiş kodu kopyala
COPY --from=builder /app/dist ./dist

# Asset dosyalarını kopyala (ejs, css)
COPY src/web/views ./dist/web/views
COPY src/web/public ./dist/web/public
# Log dizinini oluştur ve node kullanıcısına ver
RUN mkdir -p /app/logs && chown -R node:node /app/logs

# Güvenlik: root yerine node kullanıcısı
USER node

CMD ["node", "dist/index.js"]
