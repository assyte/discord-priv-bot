{
  "name": "premium-discord-bot",
  "version": "1.0.0",
  "description": "Premium Turkish Discord Bot - Moderation, Guard, Registration, Invite, Log, Report",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "npx @biomejs/biome check src/",
    "format": "npx @biomejs/biome format --write src/",
    "migrate": "drizzle-kit push:pg",
    "migrate:generate": "drizzle-kit generate:pg",
    "migrate:drop": "drizzle-kit drop",
    "studio": "drizzle-kit studio",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.18.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.0",
    "ejs": "^6.0.1",
    "eventemitter3": "^5.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "i18next": "^24.2.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "mariadb": "^3.5.3",
    "node-cron": "^4.5.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-steam": "^1.0.18",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-discord": "^0.1.15",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
